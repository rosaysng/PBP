        "from sklearn.metrics import silhouette_score\n",
        "sil_scores = []\n",
        "k_range = range(2, 11)  # Silhouette score biasanya dihitung untuk k >= 2\n",
        "\n",
        "# Melakukan K-Means untuk setiap jumlah cluster dan menghitung Silhouette Score\n",
        "for k in k_range:\n",
        "    kmeans = KMeans(n_clusters=k, init='k-means++', max_iter=300, n_init=10, random_state=42)\n",
        "    cluster_labels = kmeans.fit_predict(pca_df)\n",
        "    score = silhouette_score(pca_df, cluster_labels)\n",
        "    sil_scores.append(score)\n",
        "    print(f\"Silhouette Score untuk k = {k} adalah {score:.4f}\")  # Menampilkan nilai di terminal\n",
        "\n",
        "# Membuat grafik Silhouette Score\n",
        "plt.figure(figsize=(8, 6))\n",
        "plt.plot(k_range, sil_scores, marker='o', color='b', linestyle='-')\n",
        "plt.title('Silhouette Score for Optimal k')\n",
        "plt.xlabel('Number of Clusters (k)')\n",
        "plt.ylabel('Silhouette Score')\n",
        "plt.grid(True)\n",
        "\n",
        "# Menampilkan nilai silhouette score di setiap titik pada grafik\n",
        "for i, score in enumerate(sil_scores):\n",
        "    plt.text(k_range[i], score, f\"{score:.2f}\", ha='center', va='bottom', fontsize=10)\n",
        "\n",
        "plt.show()\n",
        "\n",
        "# Menampilkan nilai silhouette score tertinggi dan jumlah cluster optimal\n",
        "optimal_k = k_range[sil_scores.index(max(sil_scores))]\n",
        "print(f'\\nJumlah cluster optimal berdasarkan Silhouette Score adalah: {optimal_k}')\n",
        "print(f'Nilai Silhouette Score tertinggi: {max(sil_scores):.4f}')"
